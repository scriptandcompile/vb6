      - kind: EndOfLineComment
        text: "'"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'Description:  This class contains code for compressing pictures, sampled via hDC, into"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
