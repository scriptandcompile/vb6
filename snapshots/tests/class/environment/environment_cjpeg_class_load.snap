          - kind: StatementList
            children:
              - kind: EndOfLineComment
                text: "'Given a HUFFMANTABLE with valid BITS and HUFFVAL, generate tables for"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'EHUFCO, EHUFSI, MAXCODE, and MINCODE so the table may be used for compression"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'and/or decompression.  In JPEG, MaxSymbol is 255 for an AC Huffman Table.  For"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'DC Tables, MaxSymbol is 11 for PP=8 bit precission, or 15 for PP=12 bit precission."
              - kind: Newline
                text: "\r\n"
