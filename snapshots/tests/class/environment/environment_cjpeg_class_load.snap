          - kind: StatementList
            children:
              - kind: EndOfLineComment
                text: "'The JPEG compression standard does not have a formal definition for image Quality."
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'This implementation defines Quality as an integer value between 1 and 100, and"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'generates quantization tables based on the value given."
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'Quality < 50  -  Poor image quality with high compression"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'Quality = 75  -  Good quality pictures for displaying on a monitor or web page ... typical for general use"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'Quality = 92  -  High quality with non-optimal compression ... Appropriate for printing ... [typical digital camera \"max quality\" setting]"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'Quality > 95  -  Wasteful ... very poor compression with little image quality improvement.  Use 24-bit BMP TrueColor if you need quality this high."
              - kind: Newline
                text: "\r\n"
