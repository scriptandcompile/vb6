                  - kind: EndOfLineComment
                    text: "'Given an 8X8 block of discretely sampled values [m_Block(0-7, 0-7)],"
                  - kind: Newline
                    text: "\r\n"
              - kind: Whitespace
                text: "    "
              - kind: DimStatement
