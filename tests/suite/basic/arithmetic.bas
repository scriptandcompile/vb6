Attribute VB_Name = "Arithmetic"
Option Explicit

' TEST: Arithmetic operations
' CATEGORY: basic
' DESCRIPTION: Integer and floating-point arithmetic.

Sub Main()
    Print #1, 2 + 2
    Print #1, 10 - 5
    Print #1, 3 * 4
    Print #1, 15 / 3
    Print #1, 7 / 2
    Print #1, 17 \ 5
    Print #1, 17 Mod 5
    Print #1, 2 ^ 10
    Print #1, (2 + 3) * 4
    Print #1, -(5)
    Print #1, 5 - -3
    Print #1, 100 \ 7
    Print #1, 100 Mod 7
    Print #1, 2 * 3 + 4 * 5
    Print #1, 1 / 3 + 2 / 3
    Print #1, 3.5 * 2
    Print #1, 100 / 4 / 5
End Sub
