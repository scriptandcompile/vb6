        text: "'Private Function IsKillerMove(ByVal ActPly As Long, Move As TMOVE) As Boolean"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'  If Move.From = 0 Then IsKillerMove = False: Exit Function"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'  IsKillerMove = True"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'  With Killer(ActPly)"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'    If Move.From = .Killer1.From Then If Move.Target = .Killer1.Target Then Exit Function"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'    If Move.From = .Killer2.From Then If Move.Target = .Killer2.Target Then Exit Function"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'    If Move.From = .Killer3.From Then If Move.Target = .Killer3.Target Then Exit Function"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'  End With"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'  IsKillerMove = False"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'End Function"
      - kind: Newline
        text: "\r\n"
      - kind: EndOfLineComment
        text: "'"
