                text: "'"
              - kind: Newline
                text: "\r\n"
              - kind: Whitespace
                text: "  "
              - kind: EndOfLineComment
                text: "'--- / Step 5. Tablebase (endgame) - not active any more because too slow with external calls"
              - kind: Newline
                text: "\r\n"
              - kind: Whitespace
                text: "  "
              - kind: EndOfLineComment
                text: "'"
              - kind: Newline
                text: "\r\n"
              - kind: Whitespace
                text: "  "
              - kind: EndOfLineComment
                text: "' Tablebase access / too slow  in live tests"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'  If IsEGTbPos And HashDepth <> TT_TB_BASE_DEPTH Then   ' Postion already done and saved in hash?"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'    Dim sTbFEN As String, lEGTBResultScore As Long, sEGTBBestMoveStr As String, sEGTBBestMoveListStr As String"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'    sTbFEN = WriteEPD()"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'    If bEGTbBaseTrace Then WriteTrace \"TB-Search: check move \" & MoveText(PrevMove) & \", ply=\" & Ply"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'    If ProbeTablebases(sTbFEN, lEGTBResultScore, True, sEGTBBestMoveStr, sEGTBBestMoveListStr) Then"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      BestMove = TextToMove(sEGTBBestMoveStr)"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      StaticEval = Eval(): lEGTBResultScore = lEGTBResultScore + StaticEval"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      If bEGTbBaseTrace Then WriteTrace \"TB-Search: Move \" & sEGTBBestMoveStr & \" \" & lEGTBResultScore & \" ply=\" & Ply"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      'Search = lEGTBResultScore"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      HashTableSave HashKey, TT_TB_BASE_DEPTH, EmptyMove, TT_EXACT, lEGTBResultScore, lEGTBResultScore, ttPv"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'      SetMove ttMove, BestMove"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'    End If"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'  End If"
              - kind: Newline
                text: "\r\n"
              - kind: EndOfLineComment
                text: "'"
              - kind: Newline
                text: "\r\n"
              - kind: Whitespace
                text: " "
              - kind: Newline
                text: "\r\n"
              - kind: Whitespace
                text: "  "
              - kind: EndOfLineComment
                text: "'--- / Step 6. Evaluate the position statically"
