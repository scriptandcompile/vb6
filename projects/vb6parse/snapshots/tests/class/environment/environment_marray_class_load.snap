                          - kind: EndOfLineComment
                            text: "'Dim z As Long, i As Long"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'If count <> rCount Then"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'i = count"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'maxitems1 = UBound(actualdata()) - LBound(actualdata)"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'maxitems = maxitems1 + 1"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'z = 1"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'If dnum > 1 Then"
                          - kind: Newline
                            text: "\r\n"
                          - kind: Newline
                            text: "\r\n"
                          - kind: Whitespace
                            text: "  "
                          - kind: EndOfLineComment
                            text: "'z = i \\ limit(dnum - 1)"
                          - kind: Newline
                            text: "\r\n"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'   If maxitems Mod z <> 0 Then"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'  maxitems = maxitems + z - maxitems Mod z"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'  maxitems1 = maxitems - 1"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'  ReDim Preserve actualdata(maxitems1)"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'  End If"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'  limit(dnum - 1) = maxitems \\ z"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'Else"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'If maxitems > 0 Then dnum = 1"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "' dtable(0) = 1"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'limit(0) = maxitems"
                          - kind: Newline
                            text: "\r\n"
                          - kind: EndOfLineComment
                            text: "'End If"
                          - kind: Newline
                            text: "\r\n"
