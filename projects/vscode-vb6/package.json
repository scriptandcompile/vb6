{
  "name": "vscode-vb6",
  "displayName": "VB6 Language Tools",
  "description": "VB6 syntax highlighting extension with a parser-synced roadmap to full language tooling.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:vb6",
    "onCommand:vb6.updateKeywordManifest",
    "onCommand:vb6.parseFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vb6",
        "aliases": [
          "Visual Basic 6",
          "VB6"
        ],
        "extensions": [
          ".bas",
          ".cls",
          ".frm",
          ".ctl",
          ".dob",
          ".vbp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vb6",
        "scopeName": "source.vb6",
        "path": "./syntaxes/vb6.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "vb6.updateKeywordManifest",
        "title": "VB6: Update Keyword Manifest"
      },
      {
        "command": "vb6.parseFile",
        "title": "VB6: Parse Current File",
        "category": "VB6"
      }
    ],
    "configuration": {
      "title": "VB6",
      "properties": {
        "vb6.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Report VB6 parser diagnostics (errors and recovery events) in the Problems panel."
        },
        "vb6.diagnostics.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds after a change before re-parsing the document."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node ./scripts/copy-assets.mjs",
    "watch": "node ./scripts/copy-assets.mjs && tsc -watch -p ./",
    "update-keywords": "node ./scripts/update-keywords.mjs",
    "build-wasm": "node ./scripts/build-wasm.mjs",
    "check-diagnostics": "node ./scripts/check-diagnostics.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
